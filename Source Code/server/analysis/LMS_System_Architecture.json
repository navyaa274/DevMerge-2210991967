  "workflows": [
    {
      "name": "Student Enrollment Workflow",
      "steps": [
        "User Registration → Profile Creation → Program Selection → Course Enrollment → Section Assignment → Notification Generation → Access Granted"
      ],
      "participants": ["Student", "Admin", "Registrar_Automation"],
      "triggers": ["student_registration", "course_enrollment"],
      "outcomes": ["enrollment_confirmed", "access_granted", "notification_sent"]
    },
    {
      "name": "Assignment Submission Workflow", 
      "steps": [
        "Assignment Creation → Student Notification → Student Submission → Universal Judge Evaluation → AI Tutor Analysis → Faculty Review → Grade Assignment → Feedback Delivery → Achievement Check → Notification Sent"
      ],
      "participants": ["Faculty", "Student", "Universal_Judge", "AI_Tutor"],
      "triggers": ["assignment_created", "submission_received"],
      "outcomes": ["submission_graded", "feedback_provided", "points_awarded"]
    },
    {
      "name": "Lab Completion Workflow",
      "steps": [
        "Lab Problem Creation → Student Access → Code Submission → Automated Testing → Performance Analysis → AI Feedback → Grade Assignment → Progress Update → Achievement Unlock → Leaderboard Update"
      ],
      "participants": ["Faculty", "Student", "Universal_Judge", "AI_Tutor", "Gamification"],
      "triggers": ["lab_started", "code_submitted"],
      "outcomes": ["lab_completed", "skills_assessed", "progress_updated"]
    },
    {
      "name": "AI Tutor Feedback Workflow",
      "steps": [
        "Submission Analysis → Code Quality Check → Logic Evaluation → Performance Assessment → Personalized Feedback Generation → Improvement Suggestions → Resource Recommendation → Progress Tracking → Follow-up Scheduling"
      ],
      "participants": ["AI_Tutor", "Student", "Universal_Judge"],
      "triggers": ["submission_received", "help_requested"],
      "outcomes": ["feedback_provided", "improvement_plan", "resources_suggested"]
    },
    {
      "name": "Grading Workflow",
      "steps": [
        "Submission Collection → Automated Evaluation → Plagiarism Check → AI Assistance → Faculty Review → Grade Assignment → Feedback Composition → Grade Publication → Notification Sent → Analytics Update"
      ],
      "participants": ["Faculty", "Universal_Judge", "AI_Tutor", "Plagiarism_Detection"],
      "triggers": ["grading_period", "submission_deadline"],
      "outcomes": ["grades_published", "feedback_available", "analytics_updated"]
    },
    {
      "name": "Notification Workflow",
      "steps": [
        "Event Detection → Priority Assessment → User Segmentation → Message Composition → Channel Selection → Delivery Execution → Read Confirmation → Follow-up Scheduling → Analytics Tracking"
      ],
      "participants": ["System", "Users", "Notification_Service"],
      "triggers": ["system_events", "user_actions", "scheduled_events"],
      "outcomes": ["notification_delivered", "user_engaged", "action_taken"]
    },
    {
      "name": "Registrar Automation Workflow",
      "steps": [
        "Policy Configuration → Student Data Analysis → Prerequisite Validation → Enrollment Processing → Schedule Generation → Resource Allocation → Intervention Detection → Compliance Check → Report Generation → Notification Distribution"
      ],
      "participants": ["Registrar_Automation", "Admin", "AI_Tutor"],
      "triggers": ["semester_start", "policy_change", "intervention_needed"],
      "outcomes": ["automation_completed", "compliance_maintained", "efficiency_improved"]
    }
  ],
  "diagram": "erDiagram\n    USERS ||--o{ ENROLLMENTS : enrolls_in\n    USERS ||--o{ SUBMISSIONS : submits\n    USERS ||--|| USER_POINTS : has\n    USERS ||--o{ ACHIEVEMENTS : earns\n    USERS ||--o{ NOTIFICATIONS : receives\n    USERS ||--o{ GRADE : receives\n    USERS ||--o{ ATTENDANCE : has\n    USERS }o--|| DEPARTMENTS : belongs_to\n    USERS }o--|| PROGRAMS : enrolled_in\n    \n    COURSES ||--o{ PROBLEMS : contains\n    COURSES ||--o{ ASSIGNMENTS : has\n    COURSES ||--o{ EXAMS : has\n    COURSES ||--o{ COURSE_MATERIALS : includes\n    COURSES }o--|| DEPARTMENTS : belongs_to\n    COURSES }o--|| PROGRAMS : part_of\n    COURSES ||--o{ ENROLLMENTS : enrolled_in\n    \n    PROBLEMS ||--o{ SUBMISSIONS : receives\n    PROBLEMS }o--|| USERS : created_by\n    \n    SUBMISSIONS ||--o{ GRADE : receives\n    SUBMISSIONS }o--|| USERS : submitted_by\n    \n    ENROLLMENTS ||--o{ SECTIONS : has\n    ENROLLMENTS }o--|| SEMESTERS : belongs_to\n    ENROLLMENTS }o--|| USERS : student_id\n    \n    SEMESTERS ||--o{ COURSES : offers\n    SEMESTERS ||--o{ ENROLLMENTS : has\n    \n    SECTIONS }o--|| COURSES : part_of\n    SECTIONS ||--o{ USERS : contains\n    SECTIONS ||--o{ ENROLLMENTS : has\n    \n    DEPARTMENTS ||--o{ PROGRAMS : offers\n    DEPARTMENTS ||--o{ COURSES : contains\n    DEPARTMENTS ||--o{ USERS : employs\n    \n    PROGRAMS ||--o{ COURSES : includes\n    PROGRAMS ||--o{ USERS : enrolls\n    \n    AI_TUTOR ||--o{ SUBMISSIONS : analyzes\n    AI_TUTOR ||--o{ USERS : provides_feedback\n    AI_TUTOR ||--o{ NOTIFICATIONS : generates\n    \n    UNIVERSAL_JUDGE ||--o{ SUBMISSIONS : evaluates\n    \n    REGISTRAR_AUTOMATION ||--o{ ENROLLMENTS : processes\n    REGISTRAR_AUTOMATION ||--o{ AUTOMATION_LOGS : creates\n    \n    FACULTY ||--o{ COURSES : teaches\n    FACULTY ||--o{ SUBMISSIONS : evaluates\n    FACULTY ||--o{ GRADE : assigns\n    \n    ADMIN ||--o{ USERS : manages\n    ADMIN ||--o{ COURSES : manages\n    ADMIN ||--o{ AUTOMATION_LOGS : monitors"
