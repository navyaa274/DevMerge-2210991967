{
  "name": "ai-university-platform",
  "version": "1.0.0",
  "description": "AI-Powered University Learning Platform - Phase 1 Implementation",
  "main": "src/index.jsx",
  "scripts": {
    "start": "react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cross-env PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:server": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/**/*.test.js' --require test/setup.js --timeout 15000 --exit",
    "test:all": "npm run test:server && npm run test",
    "test:coverage": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 nyc mocha 'test/**/*.test.js' --require test/setup.js --timeout 15000 --exit",
    "test:watch": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/**/*.test.js' --require test/setup.js --timeout 15000 --watch",
    "test:unit": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/unit/**/*.test.js' --require test/setup.js --timeout 15000 --exit",
    "test:integration": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/integration/**/*.test.js' --require test/setup.js --timeout 15000 --exit",
    "test:e2e": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/e2e/**/*.test.js' --require test/setup.js --timeout 30000 --exit",
    "test:performance": "cross-env NODE_ENV=test USE_INMEMORY_MONGO_TESTS=1 mocha 'test/performance/**/*.test.js' --require test/setup.js --timeout 60000 --exit",
    "eject": "react-scripts eject",
    "seed": "node server/seed.js",
    "docker:build": "docker build -t ai-university-platform .",
    "docker:run": "docker run -p 5002:5002 ai-university-platform",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "lint": "eslint server/ --ext .js",
    "lint:fix": "eslint server/ --ext .js --fix",
    "format": "prettier --write \"server/**/*.js\"",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js server/routes/*.js -o docs/swagger.json",
    "security:audit": "npm audit",
    "security:check": "npm audit --audit-level high",
    "performance:test": "artillery run performance/load-test.yml",
    "backup:db": "node server/scripts/backup.js",
    "migrate:db": "node server/scripts/migrate.js",
    "start:prod": "NODE_ENV=production npm start",
    "deploy": "node deploy.js",
    "build:prod": "NODE_ENV=production npm run build",
    "deploy:frontend": "npm run build && npm run serve"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "esprima": "^4.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.35.2",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "mongoose": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^6.27.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.7.0",
    "redis": "^4.7.1",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "speakeasy": "^2.0.0",
    "string-similarity": "^4.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tailwind-merge": "^2.6.1",
    "tw-elements": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss": "^1.0.14",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "chai": "^4.5.0",
    "concurrently": "^7.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^27.5.1",
    "mocha": "^10.8.2",
    "mongodb-memory-server": "^11.0.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^2.0.20",
    "nyc": "^15.1.0",
    "postcss": "^8.5.8",
    "prettier": "^3.2.5",
    "react-scripts": "5.0.1",
    "sinon": "^17.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ai-university-platform.git"
  },
  "keywords": [
    "education",
    "ai",
    "university",
    "lms",
    "learning-platform",
    "edtech"
  ],
  "author": "AI University Platform Team",
  "license": "MIT"
}
